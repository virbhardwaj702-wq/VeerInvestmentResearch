rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'virbhardwaj702@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'isSubscriber', 'createdAt']) && data.keys().size() == 4
          && data.email is string && data.email.size() <= 256
          && data.role is string && (data.role == 'Admin' || data.role == 'User')
          && data.isSubscriber is bool
          && data.createdAt is number;
    }

    function isValidStockRecord(data) {
      return data.keys().hasAll(['userId', 'symbol', 'companyName', 'currentPrice', 'type', 'status', 'timeframes', 'candlePatterns', 'createdAt', 'updatedAt']) && data.keys().size() == 10
          && data.userId is string
          && data.userId == request.auth.uid
          && data.symbol is string && data.symbol.size() <= 30
          && data.companyName is string && data.companyName.size() <= 150
          && data.currentPrice is number
          && data.type is string && (data.type == 'Demand' || data.type == 'Supply')
          && data.status is string && (data.status == 'Approaching' || data.status == 'In the zone' || data.status == 'Reacting from zone')
          && data.timeframes is list && data.timeframes.size() <= 6
          && data.candlePatterns is list && data.candlePatterns.size() <= 2
          && data.createdAt is number
          && data.updatedAt is number;
    }

    function isValidTradeRecord(data) {
      let isBasicValid = data.keys().hasAll(['userId', 'symbol', 'companyName', 'side', 'entryPrice', 'stopLoss', 'target', 'duration', 'status', 'createdAt', 'updatedAt'])
          && data.userId is string
          && data.userId == request.auth.uid
          && data.symbol is string && data.symbol.size() <= 30
          && data.companyName is string && data.companyName.size() <= 150
          && data.side is string && (data.side == 'Buy' || data.side == 'Sell')
          && data.entryPrice is number
          && data.stopLoss is number
          && data.target is number
          && data.duration is string && (data.duration == 'Long Term' || data.duration == 'Short Term')
          && data.status is string && (data.status == 'Open' || data.status == 'Won' || data.status == 'Lost' || data.status == 'Breakeven' || data.status == 'Closed')
          && data.createdAt is number
          && data.updatedAt is number;

      let hasCurrentPrice = data.keys().hasAny(['currentPrice']) ? data.currentPrice is number : true;
      let hasExitPrice = data.keys().hasAny(['exitPrice']) ? data.exitPrice is number : true;
      let sizeCheck = data.keys().size() >= 11 && data.keys().size() <= 13;

      return isBasicValid && hasCurrentPrice && hasExitPrice && sizeCheck;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.email == request.auth.token.email || isAdmin());
      
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId
                    && isValidUser(incoming())
                    && incoming().isSubscriber == false
                    && (incoming().role == 'User' || request.auth.token.email == 'virbhardwaj702@gmail.com');

      allow update: if isValidId(userId) && isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['email'])
         && incoming().email is string && incoming().email.size() <= 256) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['role', 'isSubscriber'])
         && incoming().role is string && (incoming().role == 'Admin' || incoming().role == 'User')
         && incoming().isSubscriber is bool)
      );
    }

    match /stockRecords/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isValidId(recordId) && isSignedIn()
                    && isValidStockRecord(incoming());

      allow update: if isValidId(recordId) && isSignedIn() 
                    && (existing().userId == request.auth.uid || isAdmin())
                    && isValidStockRecord(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['symbol', 'companyName', 'currentPrice', 'type', 'status', 'timeframes', 'candlePatterns', 'updatedAt'])
                    && incoming().createdAt == existing().createdAt
                    && incoming().userId == existing().userId;

      allow delete: if isValidId(recordId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /tradeRecords/{tradeId} {
      allow get: if isValidId(tradeId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isValidId(tradeId) && isSignedIn()
                    && isValidTradeRecord(incoming());

      allow update: if isValidId(tradeId) && isSignedIn()
                    && (existing().userId == request.auth.uid || isAdmin())
                    && isValidTradeRecord(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['symbol', 'companyName', 'currentPrice', 'side', 'entryPrice', 'stopLoss', 'target', 'duration', 'status', 'exitPrice', 'updatedAt'])
                    && incoming().createdAt == existing().createdAt
                    && incoming().userId == existing().userId;

      allow delete: if isValidId(tradeId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
